# Copy this file to .env before running `docker compose up`. Never commit .env.

# PostgreSQL (the API receives a DATABASE_URL built from these values)
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PASSWORD=change-me-local-only

# Application
LOG_LEVEL=INFO

# Optional: a Hugging Face token raises the download rate limits when the worker fetches models.
# HF_TOKEN=

# Used by the commands you run on the host (python -m rag_engine.workers.bulk_ingest ...) once
# docker-compose.host-ports.yml publishes the services on localhost. Keep the password in sync
# with POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://rag:change-me-local-only@localhost:5432/rag
# QDRANT_URL=http://localhost:6333
# QDRANT_PREFER_GRPC=true

# Optional: limits for the bulk-ingestion worker (defaults are 2 cores and 3g). Raise them on a
# machine with more resources to finish the BM25 and loading passes sooner.
# WORKER_CPUS=2
# WORKER_MEMORY=3g

# Optional, for answer generation and judging in the evaluation (Phase 4 onwards). Create it at
# https://platform.claude.com/settings/keys, scope it to a workspace with a spend limit, and keep it
# only in your local .env: it is a secret.
# ANTHROPIC_API_KEY=
# With a key, POST /v1/query writes a cited answer and a judge model checks each citation against the
# passage it cites. LLM_MODEL writes (claude-haiku-5-5 by default, cheap); VERIFICATION_MODEL judges
# (defaults to LLM_MODEL; a stronger one is stricter and costs more); QUERY_CHUNKS is how many
# passages the answer is written from; VERIFY_CITATIONS=false skips the judge unless a request asks.
# LLM_MODEL=claude-haiku-5-5
# VERIFICATION_MODEL=
# VERIFY_CITATIONS=true
# QUERY_CHUNKS=5
# Decline to answer, without calling the model, when the best reranked passage scores below this
# (the score of the reranker named below, so a value is only valid for that model; empty never
# declines on score). With no passage retrieved at all, the answer is always declined.
# ABSTAIN_THRESHOLD=

# Optional: enable the `hybrid+rerank` search mode by naming a cross-encoder. BAAI/bge-reranker-v2-m3
# was the most accurate in the ablation but needs a GPU; BAAI/bge-reranker-base is the lighter one.
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
