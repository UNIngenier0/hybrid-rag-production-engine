# Secrets and local configuration
.env
.env.*
!.env.example

# Benchmark corpus and other downloaded data (large, never committed)
data/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Evaluation caches (candidate lists, reranker scores) are large and reproducible.
eval/cache/

# The agent run copies the benchmark questions (with gold answers) next to its answers.
eval/runs/*/questions.jsonl
# Small runs made by scripts/e2e.sh
eval/runs/e2e-*/
eval/runs/e2e-comparison.*
# The metering proxy's log, kept next to each usage report
eval/runs/*/*.proxy.log
